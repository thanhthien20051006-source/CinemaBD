{
  "Database": {
    "AllowAutoMigrate": false,
    "AllowedNames": []
  },
  "ShowtimeExpiry": {
    "Enabled": false
  },
  "DatabaseSeed": {
    "SchemaSqlFile": "Database/CinemaBD.schema.sql",
    "DataSqlFile": "Database/CinemaBD.data.sql",
    "AllowDemoData": false
  },
  "DataProtection": {
    "KeyDirectory": "App_Data/DataProtection-Keys"
  },
  "Jwt": {
    "Issuer": "CinemaBD",
    "Audience": "CinemaBD.Client",
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
  },
  "VnPay": {
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "https://localhost:7188/booking/payment-return",
    "TmnCode": "CHANGE_ME_VNPAY_TMN_CODE",
    "HashSecret": "CHANGE_ME_VNPAY_HASH_SECRET"
  },
  "Security": {
    "QrSigningKey": "CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES",
    "QrMaxAgeSeconds": 2592000,
    "AccountLockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "WarningThreshold": 3
    },
    "RateLimits": {
      "AuthIpPermitLimit": 10,
      "AuthAccountPermitLimit": 5,
      "AuthWindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7188" ]
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "FromEmail": "change-me@example.com",
    "FromName": "CinemaBD",
    "FromPassword": "CHANGE_ME"
  },
  "GoogleAuth": {
    "ClientIds": [
      "YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
