@{
    ViewData["Title"] = "Tạo tài khoản quản trị";
    var roles = ViewBag.Roles as IReadOnlyCollection<CinemaBD.Web.Models.RoleFormViewModel> ?? Array.Empty<CinemaBD.Web.Models.RoleFormViewModel>();
    var oneTimePassword = ViewBag.TemporaryPassword as string;
}
<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-4">Tạo tài khoản quản trị</h1>
                    @if (oneTimePassword is not null)
                    {
                        <div class="alert alert-success" role="status">
                            <p class="mb-2">Tài khoản đã được tạo. Mã tài khoản: <strong>@ViewBag.CreatedAdminId</strong></p>
                            <label class="form-label" for="temporaryPassword">Mật khẩu tạm thời (chỉ hiển thị lần này)</label>
                            <div class="input-group mb-2">
                                <input id="temporaryPassword" class="form-control font-monospace" value="@oneTimePassword" readonly autocomplete="off" />
                                <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('temporaryPassword').value)">Sao chép</button>
                            </div>
                            <strong>Sao chép và đưa cho người dùng qua kênh trực tiếp. Trang này sẽ không hiển thị lại mật khẩu.</strong>
                        </div>
                        <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminUserCreate" asp-action="Index">Tạo tài khoản khác</a>
                    }
                    else
                    {
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        }
                        <form asp-area="Admin" asp-controller="AdminUserCreate" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input id="username" name="username" class="form-control" minlength="3" maxlength="32" pattern="[A-Za-z0-9_]{3,32}" required autocomplete="off" />
                            </div>
                            <div class="mb-3">
                                <label for="fullName" class="form-label">Họ tên</label>
                                <input id="fullName" name="fullName" class="form-control" maxlength="100" required />
                            </div>
                            <div class="mb-4">
                                <label for="roleId" class="form-label">Chức vụ</label>
                                <select id="roleId" name="roleId" class="form-select" required>
                                    <option value="">-- Chọn chức vụ --</option>
                                    @foreach (var role in roles)
                                    {
                                        <option value="@role.Id">@role.Name</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary" disabled="@(roles.Count == 0)">Tạo tài khoản</button>
                            @if (roles.Count == 0)
                            {
                                <p class="text-muted mt-2 mb-0">Không có chức vụ thường đang hoạt động để lựa chọn.</p>
                            }
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
