<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules. See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-network>
        <!-- Do not backup DataStore token to cloud -->
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/token_prefs.preferences_pb"/>
    </cloud-network>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="file" path="datastore/token_prefs.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
