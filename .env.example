# Copy file này thành .env rồi chỉnh lại nếu cần

# SQL Server local cho Docker API. Bật TCP/IP, SQL Authentication/Mixed Mode và port 1433 trên SQL Server local.
# Thay placeholder và DB name bằng đúng môi trường của bạn; API không còn mặc định trỏ vào CinemaBD.
LOCAL_SQL_CONNECTION=Server=host.docker.internal,1433;Database=YOUR_DEV_DATABASE;User Id=sa;Password=CHANGE_ME_LOCAL_SA_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True

# Bảo vệ database: cả hai điều kiện phải được bật/cho phép để initializer thay đổi schema/dữ liệu.
# Giữ false nếu chưa chủ động chọn database; allowed name phải trùng Initial Catalog trong connection string.
DATABASE_ALLOW_AUTO_MIGRATE=false
DATABASE_ALLOWED_NAME=YOUR_DEV_DATABASE
DATABASE_ALLOW_DEMO_DATA=false
SHOWTIME_EXPIRY_ENABLED=false

# SQL Server container dự phòng, chỉ dùng khi chạy profile container-db
SA_PASSWORD=Your_strong_password123!
DB_NAME=CinemaBD

# Tạo secrets riêng, ngẫu nhiên và tối thiểu 32 bytes; CHANGE_ME cố ý làm ứng dụng từ chối khởi động
JWT_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=CinemaBD
JWT_AUDIENCE=CinemaBD.Client

# Public URL khi chạy local Docker HTTP; production phải dùng HTTPS và domain công khai
WEB_PUBLIC_URL=http://localhost:7188

# Dùng chung giữa API và Web; thay bằng secret ngẫu nhiên riêng (ít nhất 32 bytes) trước khi deploy
QR_SIGNING_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# Origin browser được phép gọi API; production chỉ dùng origin HTTPS thực tế
CORS_ALLOWED_ORIGIN=https://localhost:7188

# VNPAY sandbox/demo
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME

# MoMo sandbox/demo
MOMO_API_URL=https://test-payment.momo.vn/gw_payment/transactionProcessor
MOMO_ACCESS_KEY=CHANGE_ME
MOMO_SECRET_KEY=CHANGE_ME
MOMO_PARTNER_CODE=MOMO
MOMO_REQUEST_TYPE=captureMoMoWallet

# Google login - để CHANGE_ME nếu không dùng Google OAuth
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Email SMTP - copy sang .env rồi điền Gmail/app password nếu dùng gửi mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM_NAME=CinemaBD
SMTP_FROM_EMAIL=your-gmail@example.com
SMTP_PASSWORD=your-gmail-app-password

# Bootstrap Admin - dùng tạo tài khoản quản trị ban đầu khi CSDL trống và AllowDemoData=false
# Bắt buộc đổi mật khẩu trong 7 ngày đầu tiên sau khi khởi tạo
BOOTSTRAP_ADMIN_USERNAME=admin_bootstrap
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD_123!

# Khóa cứu hộ khẩn cấp Master Admin (Emergency Recovery Key) - tách biệt với BOOTSTRAP_ADMIN_PASSWORD
# Dùng để reset MFA khi Master admin mất toàn bộ thiết bị và mã khôi phục (quy trình Dual-Control)
ADMIN_RECOVERY_KEY=CHANGE_ME_GENERATE_A_RANDOM_RECOVERY_KEY_AT_LEAST_32_BYTES

